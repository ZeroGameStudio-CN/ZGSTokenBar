{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerogamestudio.com/schemas/zgstokenbar/local-api.v1.json",
  "title": "ZGSTokenBar local API envelope v1",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "method"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "method": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)+$"
        },
        "params": { "type": ["object", "null"] }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "requestId", "ok"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "type": "string", "minLength": 1, "maxLength": 64 },
            "message": { "type": "string", "maxLength": 512 },
            "retryable": { "type": "boolean" },
            "details": {
              "type": ["object", "null"],
              "additionalProperties": { "type": "string", "maxLength": 512 }
            }
          }
        }
      }
    }
  }
}
