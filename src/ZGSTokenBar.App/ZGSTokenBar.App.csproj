<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ZGSTokenBar</AssemblyName>
    <RootNamespace>ZGSTokenBar.App</RootNamespace>
    <Product>ZGSTokenBar</Product>
    <Description>Native quota bar for Claude and Codex</Description>
    <Authors>ZeroGameStudio</Authors>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- A taskbar app is idle almost always: no background GC thread, and compact the LOH eagerly. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <!-- Workstation GC sizes gen0 from the L3 cache (96 MB+ on X3D parts); an idle bar needs far less. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="8388608" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZGSTokenBar.Core\ZGSTokenBar.Core.csproj" />
    <ProjectReference Include="..\ZGSTokenBar.PluginAdapters\ZGSTokenBar.PluginAdapters.csproj" />
    <ProjectReference Include="..\ZGSTokenBar.PluginSdk\ZGSTokenBar.PluginSdk.csproj" />
    <ProjectReference Include="..\ZGSTokenBar.Builtins\ZGSTokenBar.Builtins.csproj" />
    <ProjectReference Include="..\ZGSTokenBar.Host\ZGSTokenBar.Host.csproj" />
    <ProjectReference Include="..\ZGSTokenBar.Transport.NamedPipe\ZGSTokenBar.Transport.NamedPipe.csproj" />
    <InternalsVisibleTo Include="ZGSTokenBar.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\claude-icon-rounded.png" LogicalName="ZGSTokenBar.App.Assets.claude-icon-rounded.png" />
    <EmbeddedResource Include="Assets\openai-official-ios-icon.png" LogicalName="ZGSTokenBar.App.Assets.openai-official-ios-icon.png" />
    <EmbeddedResource Include="Assets\deepseek-whale-icon.png" LogicalName="ZGSTokenBar.App.Assets.deepseek-whale-icon.png" />
    <EmbeddedResource Include="Assets\fluent-clock-20-regular.png" LogicalName="ZGSTokenBar.App.Assets.fluent-clock-20-regular.png" />
    <EmbeddedResource Include="Assets\antigravity-official-icon.png" LogicalName="ZGSTokenBar.App.Assets.antigravity-official-icon.png" />
    <EmbeddedResource Include="Assets\cursor-official-icon.png" LogicalName="ZGSTokenBar.App.Assets.cursor-official-icon.png" />
    <EmbeddedResource Include="Assets\opencode-official-icon.png" LogicalName="ZGSTokenBar.App.Assets.opencode-official-icon.png" />
    <EmbeddedResource Include="Assets\openrouter-official-icon.png" LogicalName="ZGSTokenBar.App.Assets.openrouter-official-icon.png" />
    <EmbeddedResource Include="Assets\xai-official-icon.png" LogicalName="ZGSTokenBar.App.Assets.xai-official-icon.png" />
    <EmbeddedResource Include="Assets\grok-official-icon.png" LogicalName="ZGSTokenBar.App.Assets.grok-official-icon.png" />
  </ItemGroup>
  <ItemGroup Condition="'$(BundledPluginPackage)' != ''">
    <EmbeddedResource Include="$(BundledPluginPackage)"
                      LogicalName="ZGSTokenBar.App.BundledPlugins.DeepSeekHarness.zgsplugin" />
  </ItemGroup>
</Project>
