<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ZGSTokenBar.Plugin.AiGatewayObserver</AssemblyName>
    <RootNamespace>ZGSTokenBar.Plugin.AiGatewayObserver</RootNamespace>
    <Product>ZGSTokenBar DeepSeek Harness Balance Plugin</Product>
    <Description>Read-only DeepSeek balance provider using the local Harness credential</Description>
    <Authors>ZeroGameStudio</Authors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ZGSTokenBar.PluginSdk\ZGSTokenBar.PluginSdk.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ZGSTokenBar.Tests" />
  </ItemGroup>
</Project>
