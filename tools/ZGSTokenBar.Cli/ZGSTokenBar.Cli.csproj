<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>ZGSTokenBar.Cli</AssemblyName>
    <RootNamespace>ZGSTokenBar.Cli</RootNamespace>
    <Product>ZGSTokenBar CLI</Product>
    <Description>Command-line control for ZGSTokenBar</Description>
    <Authors>ZeroGameStudio</Authors>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <OptimizationPreference>Size</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZGSTokenBar.Core\ZGSTokenBar.Core.csproj" />
    <ProjectReference Include="..\..\src\ZGSTokenBar.PluginSdk\ZGSTokenBar.PluginSdk.csproj" />
    <ProjectReference Include="..\..\src\ZGSTokenBar.Builtins\ZGSTokenBar.Builtins.csproj" />
    <ProjectReference Include="..\..\src\ZGSTokenBar.Host\ZGSTokenBar.Host.csproj" />
    <ProjectReference Include="..\..\src\ZGSTokenBar.Transport.NamedPipe\ZGSTokenBar.Transport.NamedPipe.csproj" />
  </ItemGroup>
</Project>
